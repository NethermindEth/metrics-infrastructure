# Service interface bindings (127.0.0.1 = localhost only; 0.0.0.0 = all interfaces)
NETHERMIND_PROMETHEUS_HOST=127.0.0.1
NETHERMIND_GRAFANA_HOST=127.0.0.1
NETHERMIND_LOKI_HOST=127.0.0.1
NETHERMIND_ALLOY_HOST=127.0.0.1

# Nethermind node collection
# EXECUTION_CONTAINER_NAME: container name used for log discovery
# NETHERMIND_METRICS_ADDRESS: address Alloy scrapes for metrics
EXECUTION_CONTAINER_NAME=nethermind
NETHERMIND_METRICS_ADDRESS=host.docker.internal:8008

# Log labels. NODE_NAME must match the node's --Metrics.NodeName ("Nethermind"
# by default) or the dashboard's Instance filter won't line up metrics and logs.
NODE_NAME=Nethermind
NETWORK=unknown
CLIENT=nethermind
